      { "id": "R002", "if": "numero_pisos > 0", "then": "area_por_piso = area_total / numero_pisos" },
      { "id": "R003", "descripcion": "Todo espacio debe registrar primero su área antes de crear componentes.", "if": "espacio.cantidad > 0 and espacio.area <= 0", "then": "aviso; el espacio no genera componentes" },
