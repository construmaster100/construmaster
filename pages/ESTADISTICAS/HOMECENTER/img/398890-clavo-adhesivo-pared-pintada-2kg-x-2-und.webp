8597,"textPrimary":4281731594,"textSecondary":4285413946,"invertedBackground":4287568153,"overlayBackground":3426093578},"darkThemeColorPalette":{"baseBackground":4280025602,"raisedBackground":4281731594,"additiveBackground":734610757,"textPrimary":4294631648,"textSecondary":4292717740,"invertedBackground":4293098620,"overlayBackground":3426093578},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBIQ040EGAUiEwiI1KzV-YCXAxUC-dIEHaz3EwPKAQSMAFPZ","commandMetadata":{"webCommandMetadata":{"url":"/@tesacolombia1324","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCHj1ugcBJ-1YyeCX8AbqvGg","canonicalBaseUrl":"/@tesacolombia1324"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_nphIfx34oSzJJqLlXagY4FzvRdmEzpopTGr4EvrzZHxQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Mostrar más"}},"simpleText":"...más"},"showLessText":{"simpleText":"Mostrar menos"},"attributedDescriptionBodyText":{"content":"El clavo adhesivo tesa® es ideal para paredes pintadas y yeso, al igual que las tiras adhesivas incluidas, estas están pensadas para colgar objetos decorativos con de forma fácil y segura en superficies delicadas y en relieve, como paredes pintadas o yeso, con una resistencia de hasta 2 kg por soporte. Es un modo muy práctico de colgar cuadros u objetos decorativos sin estropear la superficie, ya que no se requiere hacer uso de las herramientas como martillos o taladros. Gracias a la tecnología Powerstrips® es muy fácil de pegar y despegar sin dejar rastro de algún pegante, la superficie queda limpia e intacta. El clavo adhesivo se puede reutilizar con una nueva tira adhesivos para contribuir al medio ambiente en las tendencias del producto sostenible y así mismo ayudar a su bolsillo.","styleRuns":[{"startIndex":0,"length":795,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":795,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294963440,"raisedBackground":4294963440,"additiveBackground":566838597,"textPrimary":4281731594,"textSecondary":4285413946,"invertedBackground":4287568153,"overlayBackground":3426093578},"darkThemeColorPalette":{"baseBackground":4280025602,"raisedBackground":4281731594,"additiveBackground":734610757,"textPrimary":4294631648,"textSecondary":4292717740,"invertedBackground":4293098620,"overlayBackground":3426093578},"colorSampledDescriptionBodyText":{"content":"El clavo adhesivo tesa® es ideal para paredes pintadas y yeso, al igual que las tiras adhesivas incluidas, estas están pensadas para colgar objetos decorativos con de forma fácil y segura en superficies delicadas y en relieve, como paredes pintadas o yeso, con una resistencia de hasta 2 kg por soporte. Es un modo muy práctico de colgar cuadros u objetos decorativos sin estropear la superficie, ya que no se requiere hacer uso de las herramientas como martillos o taladros. Gracias a la tecnología Powerstrips® es muy fácil de pegar y despegar sin dejar rastro de algún pegante, la superficie queda limpia e intacta. El clavo adhesivo se puede reutilizar con una nueva tira adhesivos para contribuir al medio ambiente en las tendencias del producto sostenible y así mismo ayudar a su bolsillo.","styleRuns":[{"startIndex":0,"length":795,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294631648},{"key":"USER_INTERFACE_THEME_LIGHT","value":4281731594}]}},"fontFamilyName":"Roboto"}]},"enableColorSampledDescriptionBodyText":true}},{"videoDescriptionInfocardsSe