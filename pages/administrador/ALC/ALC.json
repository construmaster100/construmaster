    "programacion": {
      "modelo": "PERT / CPM",
      "constante_tiempo": "K = meses_categoria * semanas_por_mes * dias_habiles_semana  (dias habiles, redondeado)",
      "semanas_por_mes": 4.33,
      "dias_habiles_semana": 6,
      "rendimiento_m2_dia_por_espacio": 1.25,
      "personas_minimo": 2,
      "personas_maximo": 5,
      "dias_rendimiento": "suma(area_espacio * cantidad) / rendimiento   (con la cuadrilla minima)",
      "personas": "min(maximo, max(minimo, redondear_arriba(minimo * dias_rendimiento / K)))",
      "duracion": "max(K, dias_rendimiento * minimo / personas)",
      "pert": { "optimista": 0.75, "pesimista": 1.5, "te": "(O + 4M + P) / 6", "sigma": "(P - O) / 6" },
      "escala": "M_capitulo = peso * duracion / ruta_critica(pesos)",
