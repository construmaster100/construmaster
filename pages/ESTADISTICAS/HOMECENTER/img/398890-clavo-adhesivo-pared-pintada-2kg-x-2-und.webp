type%3Df_view%3Btype%3Dview%3Butuid%3DHj1ugcBJ-1YyeCX8AbqvGg%3Butvid%3DFmpibA0b14g\u0026foc_id=Hj1ugcBJ-1YyeCX8AbqvGg\u0026label=followon_view\u0026ptype=f_view\u0026random=124461780\u0026utuid=Hj1ugcBJ-1YyeCX8AbqvGg","elapsedMediaTimeSeconds":0},"googleRemarketingUrl":{"baseUrl":"https://www.google.com/pagead/1p-user-list/962985656/?backend=innertube\u0026cname=1\u0026cver=2_20260921\u0026data=backend%3Dinnertube%3Bcname%3D1%3Bcver%3D2_20260921%3Bptype%3Df_view%3Btype%3Dview%3Butuid%3DHj1ugcBJ-1YyeCX8AbqvGg%3Butvid%3DFmpibA0b14g\u0026is_vtc=0\u0026ptype=f_view\u0026random=1010365289\u0026utuid=Hj1ugcBJ-1YyeCX8AbqvGg","elapsedMediaTimeSeconds":0}},"videoDetails":{"videoId":"FmpibA0b14g","title":"Clavo Adhesivo hasta 2Kg para Pared Pintada tesa (77776)","lengthSeconds":"117","channelId":"UCHj1ugcBJ-1YyeCX8AbqvGg","isOwnerViewing":false,"shortDescription":"El clavo adhesivo tesa® es ideal para paredes pintadas y yeso, al igual que las tiras adhesivas incluidas, estas están pensadas para colgar objetos decorativos con de forma fácil y segura en superficies delicadas y en relieve, como paredes pintadas o yeso, con una resistencia de hasta 2 kg por soporte. Es un modo muy práctico de colgar cuadros u objetos decorativos sin estropear la superficie, ya que no se requiere hacer uso de las herramientas como martillos o taladros. Gracias a la tecnología Powerstrips® es muy fácil de pegar y despegar sin dejar rastro de algún pegante, la superficie queda limpia e intacta. El clavo adhesivo se puede reutilizar con una nueva tira adhesivos para contribuir al medio ambiente en las tendencias del producto sostenible y así mismo ayudar a su bolsillo.","isCrawlable":true,"thumbnail":{"thumbnails":[{"url":"https://i.ytimg.com/vi/FmpibA0b14g/hqdefault.jpg?sqp=-oaymwEiCKgBEF5IWvKriqkDFQgBFQAAAAAYASUAAMhCPQCAokN4AQ==\u0026rs=AOn4CLD1o6_T-kjSocPdIRsjyo72j95aWQ","width":168,"height":94},{"url":"https://i.ytimg.com/vi/FmpibA0b14g/hqdefault.jpg?sqp=-oaymwEiCMQBEG5IWvKriqkDFQgBFQAAAAAYASUAAM