      "precedencias": { "1": [], "2": [1], "3": [2], "4": [2], "5": [2], "6": [3, 4, 5], "7": [6], "8": [7], "9": [6], "10": [6], "11": [6], "12": [11], "13": [9, 11], "14": [8, 10, 12, 13] },
      "calendario": "dias habiles desde la fecha de inicio; domingo libre (y sabado si se trabajan 5 dias); sin festivos"
    },

