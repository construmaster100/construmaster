lityText":"15 “Me gusta”","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566851397,"textPrimary":4281735690,"textSecondary":4285419066,"invertedBackground":4287579673,"overlayBackground":3426097674},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281735690,"additiveBackground":734623557,"textPrimary":4294634208,"textSecondary":4292722348,"invertedBackground":4293108604,"overlayBackground":3426097674},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"Egt2ek1jVVNDbUJHMCDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"9,777"},"label":{"simpleText":"Vistas"},"accessibilityText":"9,777 vistas","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566851397,"textPrimary":4281735690,"textSecondary":4285419066,"invertedBackground":4287579673,"overlayBackground":3426097674},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281735690,"additiveBackground":734623557,"textPrimary":4294634208,"textSecondary":4292722348,"invertedBackground":4293108604,"overlayBackground":3426097674},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2020"},"label":{"simpleText":"27 mar"},"accessibilityText":"27 mar 2020","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566851397,"textPrimary":4281735690,"textSecondary":4285419066,"invertedBackground":4287579673,"overlayBackground":3426097674},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281735690,"additiveBackground":734623557,"textPrimary":4294634208,"textSecondary":4292722348,"invertedBackground":4293108604,"overlayBackground":3426097674},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBQQ040EGAYiEwiO4KnV-YCXAxVPv8sBHeaLKcXKAQTzlQLP","commandMetadata":{"webCommandMetadata":{"url":"/@tesacolombia1324","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCHj1ugcBJ-1YyeCX8AbqvGg","canonicalBaseUrl":"/@tesacolombia1324"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_nphIfx34oSzJJqLlXagY4FzvRdmEzpopTGr4EvrzZHxQ=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"Mostrar más"}},"simpleText":"...más"},"showLessText":{"simpleText":"Mostrar menos"},"attributedDescriptionBodyText":{"content":"Los tesa® doble faz espejos como su nombre indica, es ideal para fijar espejos en cualquier superficie, con o sin humedad.Para conseguir la mejor adherencia posible debes limpiar muy bien la superficie, así mismo el objeto con alcohol o limpia cristales. La superficie debe estar seca antes de la aplicación. Ofrece una sujeción segura en azulejos, podrás colgar el objeto exactamente donde desees, sin necesidad de herramientas que podrían dañar la superficie e incluso en espacios húmedos como baños y cocinas. Es ideal para superficies difíciles de taladrar. Este rollo inteligente es lo único que necesitas para colgar de forma fiable espejos y objetos de hasta 70x70cm y 4mm de grosor.","styleRuns":[{"startIndex":0,"length":690,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":690,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}],"backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294964720,"raisedBackground":4294964720,"additiveBackground":566851397,"textPrimary":4281735690,"textSecondary":4285419066,"invertedBackground":4287579673,"overlayBackground":3426097674},"darkThemeColorPalette":{"baseBackground":4280028162,"raisedBackground":4281735690,"additiveBackground":734623557,"textPrimary":4294634208,"textSecondary":4292722348,"invertedBackground":4293108604,"overlayBackground":3426097674},"colorSampledDescriptionBodyText":{"content":"Los tesa® doble faz espejos como su nombre indica, es ideal para fijar espejos en cualquier superficie, con o sin humedad.Para conseguir la mejor adherencia posible debes limpiar muy bien la superficie, así mismo el objeto con alcohol o limpia cristales. La superficie debe estar seca antes de la aplicación. Ofrece una sujeción segura en azulejos, podrás colgar el objeto exactamente donde desees, sin necesidad de herramientas que podrían dañar la superficie e incluso en espacios húmedos como baños y cocinas. Es ideal para superficies difíciles de taladrar. Este rollo inteligente es lo único que necesitas para colgar de forma fiable espejos y objetos de hasta 70x70cm y 4mm de grosor.","styleRuns":[{"startIndex":0,"length":690,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294634208},{"key":"USER_INTERFACE_THEME_LIGHT","value":4281735690}]}},"fontFamilyName":"Roboto"}]},"enableColorSampledDescriptionBodyText":true}},{"videoDescriptionTranscriptSectionRenderer":{"sectionTitle":{"runs":[{"text":"Transcripción"}]},"subHeaderText":{"runs":[{"text":"Sigue el contenido con la transcripción."}]},"primaryButton":{"buttonRenderer":{"style":"STYLE_SUGGESTIVE","size":"SIZE_DEFAULT","isDisabled":false,"text":{"runs":[{"text":"Mostrar transcripción"}]},"trackingParams":"CBkQtooIIhMIjuCp1fmAlwMVT7_LAR3miynF","command":{"clickTrackingParams":"CBkQtooIIhMIjuCp1fmAlwMVT7_LAR3miynFygEE85UCzw==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CBkQtooIIhMIjuCp1fmAlw