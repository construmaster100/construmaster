AvnSBB2s9xMDygEEjABT2Q==","scrollToEngagementPanelCommand":{"targetId":"engagement-panel-structured-description"}}]}},"showLessCommand":{"clickTrackingParams":"CLIBEM2rARgBIhMIiNSs1fmAlwMVAvnSBB2s9xMDygEEjABT2Q==","changeEngagementPanelVisibilityAction":{"targetId":"engagement-panel-structured-description","visibility":"ENGAGEMENT_PANEL_VISIBILITY_HIDDEN"}},"attributedDescription":{"content":"El clavo adhesivo tesa® es ideal para paredes pintadas y yeso, al igual que las tiras adhesivas incluidas, estas están pensadas para colgar objetos decorativos con de forma fácil y segura en superficies delicadas y en relieve, como paredes pintadas o yeso, con una resistencia de hasta 2 kg por soporte. Es un modo muy práctico de colgar cuadros u objetos decorativos sin estropear la superficie, ya que no se requiere hacer uso de las herramientas como martillos o taladros. Gracias a la tecnología Powerstrips® es muy fácil de pegar y despegar sin dejar rastro de algún pegante, la superficie queda limpia e intacta. El clavo adhesivo se puede reutilizar con una nueva tira adhesivos para contribuir al medio ambiente en las tendencias del producto sostenible y así mismo ayudar a su bolsillo.","styleRuns":[{"startIndex":0,"length":795,"styleRunExtensions":{"styleRunColorMapExtension":{"colorMap":[{"key":"USER_INTERFACE_THEME_DARK","value":4294967295},{"key":"USER_INTERFACE_THEME_LIGHT","value":4279440147}]}},"fontFamilyName":"Roboto"}]},"headerRuns":[{"startIndex":0,"length":795,"headerMapping":"ATTRIBUTED_STRING_HEADER_MAPPING_UNSPECIFIED"}]}},{"compositeVideoPrimaryInfoRenderer":{}},{"itemSectionRenderer":{"contents":[{"continuationItemRenderer":{"trigger":"CONTINUATION_TRIGGER_ON_ITEM_SHOWN","continuationEndpoint":{"clickTrackingParams":"CLABELsvGAMiEwiI1KzV-YCXAxUC-dIEHaz3EwPKAQSMAFPZ","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/next"}},"continuationCommand":{"token":"Eg0SC0ZtcGliQTBiMTRnGAYyJSIRIgtGbXBpYkEwYjE0ZzAAeAJCEGNvbW1lbnRzLXNlY3Rpb24%3D"